<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SolarBmsMonitor.App.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    Title="Resumen">

    <Grid
        x:Name="PageRoot"
        Padding="18,14,18,14"
        BackgroundColor="{StaticResource WarmWhite}"
        RowDefinitions="Auto,*">

        <Grid ColumnDefinitions="Auto,*,Auto" HeightRequest="54">
            <Image
                HeightRequest="46"
                Source="solar_must_mark.png"
                WidthRequest="46" />
            <VerticalStackLayout
                Grid.Column="1"
                Margin="8,0,0,0"
                Spacing="0"
                VerticalOptions="Center">
                <Label
                    FontFamily="OpenSansSemibold"
                    FontSize="20"
                    Text="Solar Master" />
                <HorizontalStackLayout Spacing="5">
                    <Ellipse
                        Fill="{StaticResource Success}"
                        HeightRequest="7"
                        VerticalOptions="Center"
                        WidthRequest="7" />
                    <Label
                        FontSize="11"
                        Text="{Binding ConnectedDeviceText}"
                        TextColor="{StaticResource TextSecondary}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
            <Button
                x:Name="OverflowButton"
                Grid.Column="2"
                BackgroundColor="White"
                Clicked="OnOverflowClicked"
                CornerRadius="23"
                FontFamily="FontAwesomeSolid"
                FontSize="20"
                HeightRequest="46"
                Padding="0"
                Text="&#xF142;"
                TextColor="{StaticResource Navy}"
                WidthRequest="46">
                <Button.Shadow>
                    <Shadow Brush="#180C2754" Offset="0,5" Opacity="0.7" Radius="12" />
                </Button.Shadow>
            </Button>
        </Grid>

        <Grid
            Grid.Row="1"
            Margin="0,12,0,0"
            RowDefinitions="Auto,Auto,132,*,Auto,Auto"
            RowSpacing="10">
            <Grid ColumnDefinitions="*,Auto">
                <Label
                    FontFamily="OpenSansSemibold"
                    FontSize="24"
                    Text="Tu batería"
                    VerticalTextAlignment="Center" />
                <Border
                    Grid.Column="1"
                    Padding="10,6"
                    BackgroundColor="{StaticResource MintLight}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 14"
                    VerticalOptions="Center">
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="11"
                        Text="{Binding ChargeStateText}"
                        TextColor="{StaticResource Success}" />
                </Border>
            </Grid>

            <Border
                Grid.Row="1"
                Padding="12,9"
                BackgroundColor="{StaticResource DangerLight}"
                IsVisible="{Binding HasActiveAlarms}"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 14">
                <Grid ColumnDefinitions="22,*" ColumnSpacing="8">
                    <Label
                        FontFamily="FontAwesomeSolid"
                        FontSize="16"
                        Text="&#xF071;"
                        TextColor="{StaticResource Danger}"
                        VerticalTextAlignment="Center" />
                    <Label
                        Grid.Column="1"
                        FontFamily="OpenSansSemibold"
                        FontSize="12"
                        LineBreakMode="TailTruncation"
                        Text="{Binding ActiveAlarmsText}"
                        TextColor="{StaticResource Danger}"
                        VerticalTextAlignment="Center" />
                </Grid>
            </Border>

            <Border
                Grid.Row="2"
                Padding="18,14"
                BackgroundColor="{StaticResource Navy}"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 26">
                <Border.Shadow>
                    <Shadow Brush="#260C2754" Offset="0,8" Opacity="0.7" Radius="18" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHistoryClicked" />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="2">
                    <Label
                        FontSize="12"
                        Text="ENERGÍA DISPONIBLE"
                        TextColor="{StaticResource NavyMuted}" />
                    <Grid
                        Grid.Row="1"
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="14"
                        VerticalOptions="Center">
                        <Label
                            FontFamily="OpenSansSemibold"
                            FontSize="49"
                            LineHeight="1"
                            Text="{Binding StateOfChargeText}"
                            TextColor="White"
                            VerticalTextAlignment="Center" />
                        <VerticalStackLayout
                            Grid.Column="1"
                            Margin="0,0,0,3"
                            Spacing="0"
                            VerticalOptions="End">
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="19"
                                Text="{Binding RemainingEnergyText}"
                                TextColor="White" />
                            <Label
                                FontSize="11"
                                Text="disponibles"
                                TextColor="{StaticResource NavyMuted}" />
                        </VerticalStackLayout>
                    </Grid>
                    <ProgressBar
                        Grid.Row="2"
                        HeightRequest="7"
                        Progress="{Binding StateOfChargeProgress}" />
                </Grid>
            </Border>

            <Grid
                Grid.Row="3"
                ColumnDefinitions="*,*"
                RowDefinitions="*,*"
                ColumnSpacing="10"
                RowSpacing="10">
                <Border Style="{StaticResource MetricCard}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHistoryClicked" />
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <Label
                            FontFamily="OpenSansSemibold"
                            FontSize="11"
                            Text="{Binding PowerFlowTitle}"
                            TextColor="{StaticResource TextSecondary}" />
                        <Border
                            Grid.Row="1"
                            Padding="8"
                            BackgroundColor="{StaticResource MintLight}"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 14">
                            <Grid ColumnDefinitions="24,*" ColumnSpacing="7">
                                <Label
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    HorizontalTextAlignment="Center"
                                    Text="&#xF0E7;"
                                    TextColor="{StaticResource Success}"
                                    VerticalTextAlignment="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="16"
                                    LineBreakMode="WordWrap"
                                    Text="{Binding PowerFlowText}"
                                    VerticalTextAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHistoryClicked" />
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="11"
                                Text="{Binding PrimaryEstimateTitle}"
                                TextColor="{StaticResource TextSecondary}" />
                            <!--  Precision of the estimate; explained on the information page.  -->
                            <Ellipse
                                Grid.Column="1"
                                Fill="{StaticResource Success}"
                                HeightRequest="8"
                                IsVisible="{Binding HasEstimatePrecision}"
                                VerticalOptions="Center"
                                WidthRequest="8">
                                <Ellipse.Triggers>
                                    <DataTrigger
                                        Binding="{Binding EstimateIsApproximate}"
                                        TargetType="Ellipse"
                                        Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Amber}" />
                                    </DataTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        </Grid>
                        <Border
                            Grid.Row="1"
                            Padding="8"
                            BackgroundColor="{StaticResource BlueLight}"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 14">
                            <Grid ColumnDefinitions="24,*" ColumnSpacing="7">
                                <Label
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    HorizontalTextAlignment="Center"
                                    Text="&#xF017;"
                                    TextColor="{StaticResource Primary}"
                                    VerticalTextAlignment="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="16"
                                    LineBreakMode="WordWrap"
                                    Text="{Binding PrimaryEstimateText}"
                                    VerticalTextAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource MetricCard}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInfoClicked" />
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <Label
                            FontFamily="OpenSansSemibold"
                            FontSize="11"
                            Text="{Binding HealthTitle}"
                            TextColor="{StaticResource TextSecondary}" />
                        <Border
                            Grid.Row="1"
                            Padding="8"
                            BackgroundColor="{StaticResource AmberLight}"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 14">
                            <Grid ColumnDefinitions="24,*" ColumnSpacing="7">
                                <Label
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    HorizontalTextAlignment="Center"
                                    Text="&#xF21E;"
                                    TextColor="{StaticResource Amber}"
                                    VerticalTextAlignment="Center" />
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="0"
                                    VerticalOptions="Center">
                                    <Label
                                        FontFamily="OpenSansSemibold"
                                        FontSize="16"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding HealthValueText}" />
                                    <Label
                                        FontSize="10"
                                        IsVisible="{Binding HealthDetailText, Converter={StaticResource HasText}}"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding HealthDetailText}"
                                        TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource MetricCard}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCellsClicked" />
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <Label
                            FontFamily="OpenSansSemibold"
                            FontSize="11"
                            Text="Equilibrio de celdas"
                            TextColor="{StaticResource TextSecondary}" />
                        <Border
                            Grid.Row="1"
                            Padding="8"
                            BackgroundColor="{StaticResource SurfaceMuted}"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 14">
                            <Grid ColumnDefinitions="24,*" ColumnSpacing="7">
                                <Label
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    HorizontalTextAlignment="Center"
                                    Text="&#xF24E;"
                                    TextColor="{StaticResource Primary}"
                                    VerticalTextAlignment="Center" />
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="0"
                                    VerticalOptions="Center">
                                    <Label
                                        FontFamily="OpenSansSemibold"
                                        FontSize="16"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding CellDeltaText}" />
                                    <Label
                                        FontSize="10"
                                        IsVisible="{Binding CellBalanceStatusText, Converter={StaticResource HasText}}"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding CellBalanceStatusText}"
                                        TextColor="{StaticResource Success}">
                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding CellBalanceIsAcceptable}"
                                                TargetType="Label"
                                                Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Amber}" />
                                            </DataTrigger>
                                            <DataTrigger
                                                Binding="{Binding CellBalanceNeedsReview}"
                                                TargetType="Label"
                                                Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border
                Grid.Row="4"
                Padding="12,9"
                BackgroundColor="{StaticResource SurfaceMuted}"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 18">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDiagnosticsClicked" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,*,*">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="1">
                        <Label FontSize="10" HorizontalTextAlignment="Center" Text="VOLTAJE" TextColor="{StaticResource TextSecondary}" />
                        <Label FontFamily="OpenSansSemibold" FontSize="14" HorizontalTextAlignment="Center" Text="{Binding VoltageText}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="1">
                        <Label FontSize="10" HorizontalTextAlignment="Center" Text="CORRIENTE" TextColor="{StaticResource TextSecondary}" />
                        <Label FontFamily="OpenSansSemibold" FontSize="14" HorizontalTextAlignment="Center" Text="{Binding CurrentText}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="1">
                        <Label FontSize="10" HorizontalTextAlignment="Center" Text="TEMP. MÁX" TextColor="{StaticResource TextSecondary}" />
                        <Label FontFamily="OpenSansSemibold" FontSize="14" HorizontalTextAlignment="Center" Text="{Binding MaximumTemperatureText}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Grid Grid.Row="5" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                <Ellipse Fill="{StaticResource TextSecondary}" HeightRequest="7" VerticalOptions="Center" WidthRequest="7">
                    <Ellipse.Triggers>
                        <DataTrigger TargetType="Ellipse" Binding="{Binding HasFreshTelemetry}" Value="True">
                            <Setter Property="Fill" Value="{StaticResource Success}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Ellipse" Binding="{Binding HasStaleTelemetry}" Value="True">
                            <Setter Property="Fill" Value="{StaticResource Danger}" />
                        </DataTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <Label Grid.Column="1" FontSize="11" Text="{Binding LastUpdatedText}" TextColor="{StaticResource TextSecondary}" VerticalTextAlignment="Center" />
                <Label Grid.Column="2" FontFamily="OpenSansSemibold" FontSize="11" Text="{Binding StaleStatusText}" TextColor="{StaticResource TextSecondary}" VerticalTextAlignment="Center">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding HasFreshTelemetry}" Value="True">
                            <Setter Property="TextColor" Value="{StaticResource Success}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding HasStaleTelemetry}" Value="True">
                            <Setter Property="TextColor" Value="{StaticResource Danger}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Grid>
        </Grid>

        <BoxView
            x:Name="MenuScrim"
            Grid.RowSpan="2"
            BackgroundColor="#120C2754"
            IsVisible="False"
            ZIndex="20">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMenuScrimTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border
            x:Name="OverflowMenu"
            Grid.RowSpan="2"
            Margin="0,58,2,0"
            Padding="8"
            BackgroundColor="White"
            HorizontalOptions="End"
            IsVisible="False"
            Stroke="{StaticResource Hairline}"
            StrokeShape="RoundRectangle 18"
            VerticalOptions="Start"
            WidthRequest="218"
            ZIndex="30">
            <Border.Shadow>
                <Shadow Brush="#2A0C2754" Offset="0,8" Opacity="0.75" Radius="18" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="1">
                <Label Margin="10,7,10,4" FontFamily="OpenSansSemibold" FontSize="12" Text="MÁS INFORMACIÓN" TextColor="{StaticResource TextSecondary}" />
                <Button Clicked="OnCellsClicked" Style="{StaticResource MenuButton}" Text="Celdas">
                    <Button.ImageSource><FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF240;" Color="{StaticResource Primary}" Size="17" /></Button.ImageSource>
                </Button>
                <Button Clicked="OnHistoryClicked" Style="{StaticResource MenuButton}" Text="Histórico">
                    <Button.ImageSource><FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF1DA;" Color="{StaticResource Primary}" Size="17" /></Button.ImageSource>
                </Button>
                <Button Clicked="OnDiagnosticsClicked" Style="{StaticResource MenuButton}" Text="Diagnóstico">
                    <Button.ImageSource><FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF0F1;" Color="{StaticResource Primary}" Size="17" /></Button.ImageSource>
                </Button>
                <Button Clicked="OnInfoClicked" Style="{StaticResource MenuButton}" Text="Información">
                    <Button.ImageSource><FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF05A;" Color="{StaticResource Primary}" Size="17" /></Button.ImageSource>
                </Button>
                <BoxView Margin="8,4" HeightRequest="1" BackgroundColor="{StaticResource Hairline}" />
                <Button Clicked="OnDisconnectClicked" Style="{StaticResource MenuButton}" Text="Desconectar">
                    <Button.ImageSource><FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF011;" Color="{StaticResource Danger}" Size="17" /></Button.ImageSource>
                </Button>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
